[Unit]
Description=Hollow WebSocket Relay (uWebSockets)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/relay
# --forwarder-peer-id: the media forwarder's identity (printed by
# hollow-forwarder on first start as "forwarder peer_id"). Startup-load only —
# update + restart on rotation.
ExecStart=/home/ubuntu/relay-uws/build/hollow-relay \
    --port 443 \
    --public-ip 141.227.186.209 \
    --domain relay.anonlisten.com \
    --keys-file /home/ubuntu/relay/keys.json \
    --cert-file /etc/letsencrypt/live/relay.anonlisten.com/fullchain.pem \
    --key-file /etc/letsencrypt/live/relay.anonlisten.com/privkey.pem \
    --forwarder-peer-id your-forwarder-peer-id-here
Environment=TURN_SECRET=your-turn-secret-here
Restart=always
RestartSec=3
LimitNOFILE=1048576
# Restart persistence: on SIGTERM the relay hands its offline buffers, opt-in
# registrations and push tokens to systemd's fd store as a memfd, and the next
# process takes them back. Memory to memory, cleared on a full stop and gone
# with the box; nothing touches the disk. Both lines are required or systemd
# drops the handoff.
NotifyAccess=main
FileDescriptorStoreMax=1
# No core dumps: a crash would otherwise write every buffered frame, peer id
# and push token to disk. The box also runs without swap for the same reason.
LimitCORE=0

[Install]
WantedBy=multi-user.target
