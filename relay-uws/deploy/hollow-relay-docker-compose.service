[Unit]
Description=Hollow Relay
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=hollow
WorkingDirectory=/opt/HOLLOW/relay-uws
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
LimitNOFILE=1048576
# No core dumps: a crash would otherwise write every buffered frame, peer id
# and push token to disk. The box also runs without swap for the same reason.
LimitCORE=0

[Install]
WantedBy=multi-user.target
